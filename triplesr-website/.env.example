# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SITE_URL=https://triplesrcommercialcleaning.com.au
# Quote form delivery: submissions are forwarded to Formspree (default form is set in src/config/site.ts).
# FORMSPREE_ENDPOINT=https://formspree.io/f/xzeeyapo
# Optional extra email delivery (Resend), e.g. for the customer confirmation email. Without this, leads are only stored locally.
RESEND_API_KEY=
RESEND_FROM="Triple SR Commercial Cleaning <quotes@triplesrcommercialcleaning.com.au>"
LEAD_NOTIFY_EMAIL=triplesrservicespty@gmail.com
# Bot protection (Cloudflare Turnstile). Optional in dev.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Salt used when hashing IPs for rate limiting
IP_HASH_SALT=change-me
